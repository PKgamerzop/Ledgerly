# Ledgerly - Client-Side Offline-First PWA
# No backend database or third-party API keys required.
# Deploy for free on Vercel, Netlify, Cloudflare Pages, or GitHub Pages.

# Optional: Application URL for production
VITE_APP_URL="https://localhost:3000"

# Optional: Firebase and Google OAuth credentials (stored in env, never committed to git)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_GOOGLE_OAUTH_CLIENT_ID=
